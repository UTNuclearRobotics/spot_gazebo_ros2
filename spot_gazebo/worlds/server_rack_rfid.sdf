<?xml version="1.0"?>
<!--
  server_rack_rfid.sdf
  Single 42U server rack populated with RFID-tagged equipment.
  Target: Gazebo Ignition Fortress (ign-gazebo 6.x) / ROS 2 Humble.

  Rack contents (1 RU = 44.45 mm, usable space starts at z = 0.05 m in the
  rack frame; the rack pose is z = -0.1, so U1 starts at world z = -0.05):
    U1-U4    ups                 (4RU UPS)
    U5       pdu                 (1RU PDU)
    U6-U7    switch_1            (2RU network switch)
    U8-U9    patch_panel_1       (2RU copper patch panel)
    U10      cable_manager_1     (1RU horizontal cable manager)
    U11-U12  switch_2
    U13-U14  patch_panel_2
    U15      cable_manager_2
    U16-U17  switch_3
    U18-U19  patch_panel_3
    U20      cable_manager_3
    U21-U22  switch_4
    U23-U24  patch_panel_4
    U25      cable_manager_4
    U26-U29  fiber_patch_panel   (4RU fiber patch panel)
    U30-U31  server_1            (2RU server)
    U32-U33  server_2
    U34-U35  server_3
    U36-U37  server_4
    U38-U39  server_5
    U40-U41  server_6
    U42      kvm                 (1RU KVM console)

  Tags: one model per item, named rfid_tag_<equipment>, on the front faceplate
  (front of rack = -Y). VISUAL-ONLY (no <collision>) so lidar / depth sensors
  and costmaps are not affected by the 4 mm protrusions.

  gz-sim has no native RFID sensor. Two read paths exist here: the RFComms +
  CommsEndpoint plugins (world plugin below, one endpoint per tag), and the
  RfidReader plugin on the robot model.
-->
<sdf version="1.9">
  <world name="server_rack_rfid">

    <plugin
        filename="ignition-gazebo-physics-system"
        name="ignition::gazebo::systems::Physics">
    </plugin>

    <plugin
        filename="ignition-gazebo-sensors-system"
        name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
        filename="ignition-gazebo-contact-system"
        name="ignition::gazebo::systems::Contact">
    </plugin>

    <plugin
        filename="ignition-gazebo-scene-broadcaster-system"
        name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="ignition-gazebo-user-commands-system"
        name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <!-- Log-distance path loss for the CommsEndpoint tags. UNCALIBRATED
         placeholders for a ~2-6 m read envelope; omnidirectional, no
         beamwidth term. -->
    <plugin
        filename="ignition-gazebo-rf-comms-system"
        name="ignition::gazebo::systems::RFComms">
      <range_config>
        <max_range>6.0</max_range>
        <fading_exponent>2.5</fading_exponent>
        <l0>40</l0>
        <sigma>10.0</sigma>
      </range_config>
      <radio_config>
        <capacity>1000000</capacity>
        <tx_power>0</tx_power>
        <noise_floor>-90</noise_floor>
        <modulation>QPSK</modulation>
      </radio_config>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>3 -3 2 0 0.4 2.3</camera_pose>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="ComponentInspector" name="Component inspector">
        <ignition-gui>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>

    </gui>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
    </scene>

    <atmosphere type="adiabatic">
       <temperature>288</temperature>
       <temperature_gradient>0.2</temperature_gradient>
    </atmosphere>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ===================== ROOM ENCLOSURE ===================== -->

    <model name="room_floor">
      <static>true</static>
      <pose>0 4.0 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>15.0 15.0 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>15.0 15.0 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_front">
      <!-- -Y wall -->
      <static>true</static>
      <pose>0 -3.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>15.0 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>15.0 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_back">
      <!-- +Y wall -->
      <static>true</static>
      <pose>0 11.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>15.0 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>15.0 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_left">
      <!-- -X wall -->
      <static>true</static>
      <pose>-7.5 4.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 15.0 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 15.0 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_right">
      <!-- +X wall -->
      <static>true</static>
      <pose>7.5 4.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 15.0 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 15.0 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="spot">
        <pose>0 0.0 0.7 0 0 0</pose>
        <include merge="true">
            <uri>package://spot_description_sim/models/spot</uri>
        </include>


         <!-- Vulcan RFID Iron USB reader: a sealed reader with ONE integrated
          antenna. A second Iron would be an independent USB device needing its
          own <plugin> block and topic, not a second <antenna> here (multiplex
          models the ports of one shared reader).

          r0 = 0.11 m at 27 dBm, derived from the datasheet's 12 in maximum read
          distance assuming a dwell of N = 10 interrogations. The datasheet does
          not state a read distance, so the number is only as good as that
          assumption.

          NEAR-FIELD FLOOR: r0(P) = 0.11 * 10^((P-27)/20). Below roughly 15 dBm
          r0 falls inside the near field (far-field boundary ~1.4 to 3.2 cm at
          915 MHz), where the 1/R^2 and 1/R^4 exponents this model is built on
          stop holding. The usable sweep is about 15 to 27 dBm, NOT the
          datasheet's full 0 to 27: an estimator swept below ~15 dBm is fitting
          a model that no longer describes the physics.
        -->

        <plugin filename="RfidReader" name="rfid::RfidReader">
          <reader_id>vulcan_iron</reader_id>
          <tag_prefix>rfid_tag_</tag_prefix>
          <update_rate>10</update_rate>   <!-- interrogation cycles [Hz] -->
          <multiplex>true</multiplex>     <!-- moot with a single antenna -->
          <max_range>1.0</max_range>      <!-- COMPUTE GUARD, not the range spec -->
          <pd_max>0.99</pd_max>
          <topic>/rfid/reads</topic>
          <seed>42</seed>                 <!-- remove for nondeterministic runs;
                                              the drawn seed is logged either way -->

          <!-- Passive-tag TF, detected tags only. GROUND TRUTH: a real reader
              returns EPC + RSSI, never range or bearing. These frames and the
              report's "r" field are for validation only; an estimator meant for
              hardware consumes the read report alone. -->
          <publish_tf>true</publish_tf>
          <tf_topic>/rfid/tf</tf_topic>
          <tf_position_noise_stddev>0.0</tf_position_noise_stddev>

          <!-- ===== TX power [dBm] =====
              r0/rssi_r0 are characterized at p_ref. Commanding P shifts the link:
                  r0_eff = r0 * 10^((P-p_ref)/20)     (forward link, 1/R^2)
                  RSSI  += (P - p_ref)                (backscatter, 1/R^4)
              See the near-field floor note above before sweeping below ~15 dBm. -->
          <power_topic>/rfid/set_power</power_topic>
          <p_ref>27.0</p_ref>
          <p_min>0.0</p_min>
          <p_max>27.0</p_max>
          <power_step>0.5</power_step>

          <!-- ===== Stochastic link — TODO(characterization) =====
              PLACEHOLDERS [dB], to be measured on the bench, not inferred from
              the sim: rssi_noise_stddev from Test B, tag_offset_stddev from
              Test C (characterization_protocol.md). 1.5 dB is a free-space
              guess; a metal aisle is materially worse.
              Set both to 0.0 for a deterministic link. -->
          <rssi_noise_stddev>1.5</rssi_noise_stddev>
          <tag_offset_stddev>2.0</tag_offset_stddev>

          <!-- Ground-truth leak: reports the true tag count, which inventory
              exists to discover. Flip to false once the estimator scores
              non-detections against its own asset manifest. -->
          <report_n_tags>true</report_n_tags>

          <!-- ===== Occlusion — TODO(characterization) =====
              Attenuation volumes in dB, not binary line of sight: at lambda
              ~33 cm a metal rack diffracts and leaks instead of casting a hard
              shadow. Each volume charges the direct antenna to tag segment
              <attenuation_db> for entering plus <attenuation_db_per_m> times the
              chord. Applied ONCE to the forward link and TWICE to RSSI.
              Values are PLACEHOLDERS; Test E measures them.

              KNOWN GAP: this models blocking, not leakage. Nothing here creates
              a read along a path that does not exist, so the sim stays
              optimistic about false localization. Closing that needs a
              reflection model, not a bigger dB.

              Geometry: rack model sits at world (0, 4.0, -0.1), front face
              (where tags live) at local y = -0.50, i.e. world y = 3.5. The body
              volume below starts at y = 3.52, inset 2 cm so a ray to a tag ON
              the front face grazes rather than clips it. Do not "clean up"
              that inset. -->
          <occluder>
            <name>rack_body</name>
            <model>server_rack</model>       <!-- rides the rack's pose -->
            <pose>0 0.035 1.015 0 0 0</pose> <!-- rack frame: front face at y=-0.50 -->
            <size>0.60 1.03 2.03</size>
            <attenuation_db>3.0</attenuation_db>          <!-- entry/exit coupling -->
            <attenuation_db_per_m>30.0</attenuation_db_per_m>  <!-- packed metal -->
          </occluder>

          <!-- ===== Antenna: the Iron, on the arm end effector =====
              <link> must name an ECM link, i.e. an SDF name. arm0_hand is real here
              (model.sdf.xacro:1087) and matches the URDF frame name, so the default
              <parent_frame> lands connected in the ROS tree. Do NOT use
              arm0_wrist_roll_link: ROS publishes arm0_wrist_roll, so the antenna TF
              would parent to a frame nobody publishes. A wrong <link> does not fail
              loudly, it warns once and then never interrogates, and the empty reads
              look exactly like an empty rack.

              TODO(mount): <pose> is a placeholder, coincident with the hand frame,
              pending mount CAD. Must stay equal to the offset in
              rfid_inventory_tracking/urdf/rfid_antenna.xacro.
              TODO(characterization): r0 / rssi_r0 / beamwidth are guesses, Tests A
              and D. -->
          <antenna>
            <name>hand</name>              <!-- TF frame: rfid_antenna_hand -->
            <link>arm0_hand</link>
            <pose>0.11873 0 -0.136 0 0 0</pose>       <!-- TODO(mount) -->
            <r0>0.11</r0>                  <!-- @27 dBm; from the 12-in spec above -->
            <delta_theta_h>80</delta_theta_h>
            <delta_theta_v>80</delta_theta_v>
            <rssi_r0>-45.0</rssi_r0>       <!-- @27 dBm at r0=0.11 m -->
            <power_dbm>27.0</power_dbm>    <!-- = p_ref -->
          </antenna>
        </plugin>
    </model>


    <!-- ===================== SERVER RACK =====================
         Front face (faceplates + tags) at local y = -0.50, world y = 3.5.
         Equipment faceplate width 0.483 m (19 in). -->
    <model name="server_rack">
      <static>true</static>
      <pose>0 4.0 -0.1 0 0 0</pose>

      <!-- Frame -->
      <link name="frame_side_left">
        <pose>-0.29 0 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="frame_side_right">
        <pose>0.29 0 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="frame_top">
        <pose>0 0 2.01 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.60 1.07 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.60 1.07 0.02</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="frame_plinth">
        <pose>0 0 0.025 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.60 1.07 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.60 1.07 0.05</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.10 0.10 0.10 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Equipment
           z_center of unit spanning Ua..Ub = 0.05 + ((a-1)+b)/2 * 0.04445 -->

      <!-- 4RU UPS, U1-U4 -->
      <link name="ups">
        <pose>0 -0.15 0.1389 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.483 0.70 0.1778</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.483 0.70 0.1778</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.10 1</ambient>
            <diffuse>0.08 0.08 0.10 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 1RU PDU, U5 -->
      <link name="pdu">
        <pose>0 -0.29 0.2500 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.483 0.42 0.0444</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.483 0.42 0.0444</size></box></geometry>
          <material>
            <ambient>0.30 0.10 0.10 1</ambient>
            <diffuse>0.30 0.10 0.10 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 2RU network switch 1, U6-U7 -->
      <link name="switch_1">
        <pose>0 -0.29 0.3167 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.483 0.42 0.0889</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.483 0.42 0.0889</size></box></geometry>
          <material>
            <ambient>0.16 0.20 0.30 1</ambient>
            <diffuse>0.16 0.20 0.30 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 2RU patch panel 1, U8-U9 -->
      <link name="patch_panel_1">
        <pose>0 -0.425 0.4056 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.483 0.15 0.0889</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.483 0.15 0.0889</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 1RU cable manager 1, U10 -->
      <link name="cable_manager_1">
        <pose>0 -0.425 0.4723 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.483 0.15 0.0444</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.483 0.15 0.0444</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.22 0.22 0.22 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 2RU network switch 2, U11-U12 -->
      <link name="switch_2">
        <pose>0 -0.29 0.5390 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.483 0.42 0.0889</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.483 0.42 0.0889</size></box></geometry>
          <material>
            <ambient>0.16 0.20 0.30 1</ambient>
            <diffuse>0.16 0.20 0.30 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 2RU patch panel 2, U13-U14 -->
      <link name="patch_panel_2">
        <pose>0 -0.425 0.6279 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.483 0.15 0.0889</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.483 0.15 0.0889</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>

