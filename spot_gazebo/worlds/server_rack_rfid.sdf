    <!-- ===================== RFID TAGS =====================
         World y = 3.497: 3 mm proud of the rack front plane (world y = 3.5).
         Tag z = rack-frame equipment z - 0.1, tracking the rack pose
         (z = -0.1); tags are separate world models, so the rack's pose
         does NOT carry them.
         Named rfid_tag_<equipment> so the reader can enumerate them by scoped
         name prefix. Each carries a CommsEndpoint with a unique EPC-style
         address for the RFComms read path. -->

    <model name="rfid_tag_ups">
      <static>true</static>
      <pose>0.18 3.497 0.0389 0 0 0</pose>
      <link name="tag_link">
        <visual name="visual">
          <geometry><box><size>0.06 0.004 0.025</size></box></geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin
          filename="ignition-gazebo-comms-endpoint-system"
          name="ignition::gazebo::systems::CommsEndpoint">
        <address>E200-0001</address>
        <topic>rfid/tag_ups/rx</topic>
      </plugin>
    </model>

