<?xml version="1.0"?>
<sdf version="1.9">
  <world name="server_room">

    <plugin
        filename="ignition-gazebo-physics-system"
        name="ignition::gazebo::systems::Physics">
    </plugin>

    <plugin
        filename="ignition-gazebo-sensors-system"
        name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
        filename="ignition-gazebo-contact-system"
        name="ignition::gazebo::systems::Contact">
    </plugin>


    <plugin
        filename="ignition-gazebo-scene-broadcaster-system"
        name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="ignition-gazebo-user-commands-system"
        name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <!-- <plugin
        filename="ignition-gazebo-log-system"
        name="ignition::gazebo::systems::LogRecord">
    </plugin> -->

    <!-- RFComms was required only by the CommsEndpoint plugins the RFID tag
         models carried. The barcode labels that replaced them carry no
         plugins at all — a printed label is passive geometry — so this world
         no longer needs it. Left commented rather than deleted because
         server_rack_rfid.sdf still depends on the same block.

    <plugin
        filename="ignition-gazebo-rf-comms-system"
        name="ignition::gazebo::systems::RFComms">
      <range_config>
        <max_range>6.0</max_range>
        <fading_exponent>2.5</fading_exponent>
        <l0>40</l0>
        <sigma>10.0</sigma>
      </range_config>
      <radio_config>
        <capacity>1000000</capacity>
        <tx_power>0</tx_power>
        <noise_floor>-90</noise_floor>
        <modulation>QPSK</modulation>
      </radio_config>
    </plugin>
    -->

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>8 -8 6 0 0.4 0.8</camera_pose>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="ComponentInspector" name="Component inspector">
        <ignition-gui>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>

    </gui>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
    </scene>

    <atmosphere type="adiabatic">
       <temperature>288</temperature>
       <temperature_gradient>0.2</temperature_gradient>
    </atmosphere>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ===================== ROOM ENCLOSURE ===================== -->
    <!-- 1.2m clearance from the outer rows' rear frame edge to the -Y and +Y
         walls. The X walls are far wider than the 4-rack rows need; the open
         floor either side is deliberate working space. -->

    <model name="room_floor">
      <static>true</static>
      <pose>0 3.405 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.51 10.48 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.51 10.48 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_front">
      <!-- -Y wall -->
      <static>true</static>
      <pose>0 -1.785 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.51 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.51 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_back">
      <!-- +Y wall -->
      <static>true</static>
      <pose>0 8.595 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.51 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.51 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_left">
      <!-- -X wall -->
      <static>true</static>
      <pose>-4.705 3.405 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 10.48 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 10.48 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_right">
      <!-- +X wall -->
      <static>true</static>
      <pose>4.705 3.405 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 10.48 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 10.48 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Facing +X, at the mouth of cold aisle 1 (y = 1.135 is its centreline)
         and clear of the rack block, which spans x = -1.20 .. 1.20. -->
    <model name="spot">
        <pose>-3.0 1.135 0.7 0 0 0</pose>
        <include merge="true">
            <uri>package://spot_description_sim/models/spot</uri>
        </include>

        <!-- Zebra Symbol LS2208 1-D laser scanner, mounted where the RFID
             antenna used to be. This world reads BARCODES; the RFID reader
             worlds (server_rack_rfid.sdf, rfid_calibration.sdf) are unchanged
             and still exercise RfidReader.

             Datasheet: Motorola "Symbol LS2208 Specification Sheet",
             SS-LS2208, 12/08 — the sheet for LS2208-SR20007R-UR.

             VERBATIM FROM THE SHEET
               update_rate      100 scans/sec typical
               print_contrast   20% minimum reflective difference
               roll_limit       +/- 30 deg
               pitch_limit      +/- 65 deg
               skew_limit       +/- 60 deg
               dof_near/far     0.0381 - 0.2540 m, i.e. the Code 39 7.5 mil
                                row (1.50" - 10.00") converted from the
                                authoritative inch column. The sheet has no
                                Code 128 row; depth of field follows the narrow
                                element width, not the symbology.

             SET BY OUR LABEL, AND THESE ARE THE ONES THAT ACTUALLY BIND
               dof_near/dof_far 7.5 mil is forced by fitting a 7-hex-digit
                                Code 128 symbol (132 modules incl. quiet
                                zones) into the 28 mm print area. A 4x
                                reduction from the RFID reader's 1.0 m
                                max_range, and the single biggest behavioural
                                change: the arm has to get within 25 cm.
               auto_roll_limit  Derives roll from the printed symbol as
                                atan((3.0 + 0.2) / 25.146) = 7.25 deg,
                                overriding the sheet's +/-30 deg. Short bars,
                                not the scanner, are the limit. Expect this to
                                dominate aiming.

             NOT IN THE DATASHEET — scan_halfangle, beam_spot and rescan_delay
             are absent from both the 12/08 and 04/15 revisions. See the
             "NOT IN THE DATASHEET" block in BarcodeScanner.cc before quoting
             any of them as a specification. -->
        <plugin filename="BarcodeScanner" name="barcode::BarcodeScanner">
          <scanner_id>ls2208</scanner_id>
          <label_prefix>barcode_label_</label_prefix>
          <update_rate>100</update_rate>
          <mode>trigger</mode>
          <!-- UNVERIFIED: not a spec-sheet value. The re-read timeout is a
               host-programmable parameter in the Product Reference Guide. -->
          <rescan_delay>0.5</rescan_delay>
          <topic>/barcode/scans</topic>
          <trigger_topic>/barcode/trigger</trigger_topic>
          <seed>42</seed>

          <publish_tf>true</publish_tf>
          <tf_topic>/barcode/tf</tf_topic>

          <dof_near>0.0381</dof_near>
          <dof_far>0.2540</dof_far>

          <symbol_width>0.0252</symbol_width>
          <symbol_height>0.003</symbol_height>
          <!-- UNVERIFIED: no spot size is published. 0.2 mm is derived from
               having to resolve one 7.5 mil narrow module (0.1905 mm). -->
          <beam_spot>0.0002</beam_spot>

          <!-- UNVERIFIED: the sheet states no scan angle. 35 deg total is the
               figure commonly quoted for this scan engine, not a spec. -->
          <scan_halfangle>17.5</scan_halfangle>
          <auto_roll_limit>true</auto_roll_limit>
          <roll_limit>30</roll_limit>
          <pitch_limit>65</pitch_limit>
          <skew_limit>60</skew_limit>
          <specular_deadzone>0</specular_deadzone>

          <print_contrast>0.20</print_contrast>
          <label_contrast>0.85</label_contrast>

          <p_decode_max>0.99</p_decode_max>
          <margin_noise>0.05</margin_noise>

          <!-- One occluder per rack INSTANCE. <model> resolves by plain,
               unscoped name against each <include><name> below, not against
               the included server_rack_N. Rename an include and occlusion
               stops with a single ignwarn. The pose is in the rack frame, so it
               follows each row's yaw; y = 0.035 insets the body 2 cm behind
               the faceplate so a ray to a front label grazes rather than clips.

               No attenuation figures here, unlike the RfidReader blocks these
               were converted from: 650 nm does not pass through a rack panel.
               Any intersection blocks the beam outright, so these volumes are
               now exact rather than placeholders pending Test E. -->
          <occluder>
            <name>rack_r0_c0</name><model>rack_r0_c0</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r0_c1</name><model>rack_r0_c1</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r0_c2</name><model>rack_r0_c2</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r0_c3</name><model>rack_r0_c3</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r1_c0</name><model>rack_r1_c0</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r1_c1</name><model>rack_r1_c1</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r1_c2</name><model>rack_r1_c2</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r1_c3</name><model>rack_r1_c3</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r2_c0</name><model>rack_r2_c0</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r2_c1</name><model>rack_r2_c1</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r2_c2</name><model>rack_r2_c2</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r2_c3</name><model>rack_r2_c3</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r3_c0</name><model>rack_r3_c0</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r3_c1</name><model>rack_r3_c1</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r3_c2</name><model>rack_r3_c2</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>
          <occluder>
            <name>rack_r3_c3</name><model>rack_r3_c3</model>
            <pose>0 0.035 1.015 0 0 0</pose><size>0.60 1.03 2.03</size>
          </occluder>

          <!-- Exit window. Inherited verbatim from the RFID antenna mount so
               the arm kinematics and any cached scan poses stay valid, and it
               is co-located with alpha_detector. Boresight is +X, the line
               sweeps in scanner XY, bar height is along scanner Z — so the
               scanner's Z axis must be roughly parallel to the label's short
               axis or the roll gate above rejects everything.

               <pose> must stay equal to the offset in
               rfid_inventory_tracking/urdf/rfid_antenna.xacro (rename that to
               barcode_scanner.xacro when the consumer package is migrated). -->
          <link>arm0_hand</link>
          <pose>0.10473 0.0049 -0.1117 0 0 0</pose>
          <parent_frame>arm0_hand</parent_frame>
        </plugin>
    </model>

    <!-- ===================== SERVER ROOM: 4 ROWS x 4 RACKS =====================

         Hot/cold aisle containment. A rack's front face is local -Y, so yaw 0
         faces world -Y and yaw pi faces world +Y.

           row 0   y = 0.00   yaw pi   faces +Y   racks 1-4, tags +X
           = COLD aisle, 1.20 m: y = 0.535 .. 1.735, fronts facing =
           row 1   y = 2.27   yaw 0    faces -Y   racks 5-8, tags -X
           = HOT aisle,  1.20 m: y = 2.805 .. 4.005, backs facing =
           row 2   y = 4.54   yaw pi   faces +Y   racks 1-4, tags +X
           = COLD aisle, 1.20 m: y = 5.075 .. 6.275, fronts facing =
           row 3   y = 6.81   yaw 0    faces -Y   racks 5-8, tags -X

         Rows 0 and 3 are the outer rows, facing in toward the room centre.
         Rows 1 and 2 are the centre pair, back to back, each facing AWAY from
         the other: outward with respect to the pair, not to the room.

         Row pitch 2.27 m = 1.07 m rack depth + 1.20 m aisle. The outer rows
         back onto the -Y and +Y walls with 1.20 m clearance.

         Racks are FLUSH within a row: 0.60 m pitch against a 0.60 m frame, so
         a row maps as one continuous 2.40 m run with no gaps. That is the
         gapless case, where bay cutting must fall back to the bay_widths
         template rather than reading periodicity.

         z = -0.05 puts the plinth on the floor (floor top is z = -0.05), so
         rack U1 starts at world z = 0.00 and ru0_z for THIS world is 0.0,
         not the -0.05 that discovery_params.yaml carries for
         server_rack_rfid.sdf.

         Rows 0 and 2 carry racks 1-4 (tags at local x = +0.18, the viewer's
         right); rows 1 and 3 carry racks 5-8 (tags at -0.18, the viewer's
         left). Both cold aisles therefore face a right-column row against a
         left-column row, which is the Phase 5 adaptive-scanning case.

         Racks 1-4 appear twice and 5-8 appear twice, so EPCs are duplicated
         between row 0 and row 2, and between row 1 and row 3. -->

    <!-- Row 0 (y = 0, yaw pi, faces +Y into cold aisle 1) -->
    <!-- Plain <include>, not a merge into a wrapper model: these racks carry
         11-23 NESTED tag models, and <include merge="true"> is the fragile
         path for those. <name> is what the occluders above resolve against. -->
    <include>
      <name>rack_r0_c0</name>
      <uri>model://server_rack_1</uri>
      <pose>-0.90 0 -0.05 0 0 3.14159265</pose>
    </include>
    <include>
      <name>rack_r0_c1</name>
      <uri>model://server_rack_2</uri>
      <pose>-0.30 0 -0.05 0 0 3.14159265</pose>
    </include>
    <include>
      <name>rack_r0_c2</name>
      <uri>model://server_rack_3</uri>
      <pose>0.30 0 -0.05 0 0 3.14159265</pose>
    </include>
    <include>
      <name>rack_r0_c3</name>
      <uri>model://server_rack_4</uri>
      <pose>0.90 0 -0.05 0 0 3.14159265</pose>
    </include>

    <!-- Row 1 (y = 2.27, yaw 0, faces -Y into cold aisle 1) -->
    <include>
      <name>rack_r1_c0</name>
      <uri>model://server_rack_5</uri>
      <pose>-0.90 2.27 -0.05 0 0 0</pose>
    </include>
    <include>
      <name>rack_r1_c1</name>
      <uri>model://server_rack_6</uri>
      <pose>-0.30 2.27 -0.05 0 0 0</pose>
    </include>
    <include>
      <name>rack_r1_c2</name>
      <uri>model://server_rack_7</uri>
      <pose>0.30 2.27 -0.05 0 0 0</pose>
    </include>
    <include>
      <name>rack_r1_c3</name>
      <uri>model://server_rack_8</uri>
      <pose>0.90 2.27 -0.05 0 0 0</pose>
    </include>

    <!-- Row 2 (y = 4.54, yaw pi, faces +Y into cold aisle 2) -->
    <include>
      <name>rack_r2_c0</name>
      <uri>model://server_rack_1</uri>
      <pose>-0.90 4.54 -0.05 0 0 3.14159265</pose>
    </include>
    <include>
      <name>rack_r2_c1</name>
      <uri>model://server_rack_2</uri>
      <pose>-0.30 4.54 -0.05 0 0 3.14159265</pose>
    </include>
    <include>
      <name>rack_r2_c2</name>
      <uri>model://server_rack_3</uri>
      <pose>0.30 4.54 -0.05 0 0 3.14159265</pose>
    </include>
    <include>
      <name>rack_r2_c3</name>
      <uri>model://server_rack_4</uri>
      <pose>0.90 4.54 -0.05 0 0 3.14159265</pose>
    </include>

    <!-- Row 3 (y = 6.81, yaw 0, faces -Y into cold aisle 2) -->
    <include>
      <name>rack_r3_c0</name>
      <uri>model://server_rack_5</uri>
      <pose>-0.90 6.81 -0.05 0 0 0</pose>
    </include>
    <include>
      <name>rack_r3_c1</name>
      <uri>model://server_rack_6</uri>
      <pose>-0.30 6.81 -0.05 0 0 0</pose>
    </include>
    <include>
