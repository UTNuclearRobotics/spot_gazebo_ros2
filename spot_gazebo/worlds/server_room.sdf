<?xml version="1.0"?>
<sdf version="1.9">
  <world name="server_room">

    <plugin
        filename="ignition-gazebo-physics-system"
        name="ignition::gazebo::systems::Physics">
    </plugin>

    <plugin
        filename="ignition-gazebo-sensors-system"
        name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
        filename="ignition-gazebo-contact-system"
        name="ignition::gazebo::systems::Contact">
    </plugin>


    <plugin
        filename="ignition-gazebo-scene-broadcaster-system"
        name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="ignition-gazebo-user-commands-system"
        name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <!-- <plugin
        filename="ignition-gazebo-log-system"
        name="ignition::gazebo::systems::LogRecord">
    </plugin> -->

    <gui fullscreen="0">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>8 -8 6 0 0.4 0.8</camera_pose>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="ComponentInspector" name="Component inspector">
        <ignition-gui>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>

    </gui>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
    </scene>

    <atmosphere type="adiabatic">
       <temperature>288</temperature>
       <temperature_gradient>0.2</temperature_gradient>
    </atmosphere>

    <!-- Global directional light -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ===================== ROOM ENCLOSURE ===================== -->
    <!-- 1.2m clearance maintained from every rack edge to nearest wall -->

    <model name="room_floor">
      <static>true</static>
      <pose>0 3.405 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.51 10.48 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.51 10.48 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_front">
      <!-- -Y wall -->
      <static>true</static>
      <pose>0 -1.785 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.51 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.51 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_back">
      <!-- +Y wall -->
      <static>true</static>
      <pose>0 8.595 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.51 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.51 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_left">
      <!-- -X wall -->
      <static>true</static>
      <pose>-4.705 3.405 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 10.48 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 10.48 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_right">
      <!-- +X wall -->
      <static>true</static>
      <pose>4.705 3.405 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 10.48 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 10.48 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="spot">
        <pose>0 -1.3 0.4 0 0 0</pose>
        <include merge="true">
            <uri>package://spot_description_sim/models/spot</uri>
        </include>
    </model>

    <!-- ===================== SERVER ROOM: 4 ROWS x 4 RACKS ===================== -->
    <!-- Row spacing (center-to-center): 1.07m rack depth + 1.2m aisle gap = 2.27m -->
    <!-- Rack spacing within row (center-to-center): 0.7m -->

    <!-- Row 0 (y = 0) -->
    <model name="rack_r0_c0">
      <pose>-3.15 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c1">
      <pose>-2.45 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c2">
      <pose>-1.75 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c3">
      <pose>-1.05 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c4">
      <pose>-0.35 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c5">
      <pose>0.35 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c6">
      <pose>1.05 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c7">
      <pose>1.75 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c8">
      <pose>2.45 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r0_c9">
      <pose>3.15 0 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>

    <!-- Row 1 (y = 2.27) -->
    <model name="rack_r1_c0">
      <pose>-3.15 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c1">
      <pose>-2.45 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c2">
      <pose>-1.75 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c3">
      <pose>-1.05 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c4">
      <pose>-0.35 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c5">
      <pose>0.35 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c6">
      <pose>1.05 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c7">
      <pose>1.75 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c8">
      <pose>2.45 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r1_c9">
      <pose>3.15 2.27 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>

    <!-- Row 2 (y = 4.54) -->
    <model name="rack_r2_c0">
      <pose>-3.15 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c1">
      <pose>-2.45 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c2">
      <pose>-1.75 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c3">
      <pose>-1.05 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c4">
      <pose>-0.35 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c5">
      <pose>0.35 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c6">
      <pose>1.05 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c7">
      <pose>1.75 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c8">
      <pose>2.45 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r2_c9">
      <pose>3.15 4.54 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>

    <!-- Row 3 (y = 6.81) -->
    <model name="rack_r3_c0">
      <pose>-3.15 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c1">
      <pose>-2.45 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c2">
      <pose>-1.75 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c3">
      <pose>-1.05 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c4">
      <pose>-0.35 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c5">
      <pose>0.35 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c6">
      <pose>1.05 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c7">
      <pose>1.75 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c8">
      <pose>2.45 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>
    <model name="rack_r3_c9">
      <pose>3.15 6.81 0 0 0 0</pose>
      <include merge="true">
        <uri>model://server_rack_model</uri>
      </include>
    </model>

  </world>
</sdf>