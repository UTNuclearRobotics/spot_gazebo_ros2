<?xml version="1.0"?>
<!--
  barcode_calibration.sdf

  rfid_calibration.sdf with the RFID tags and RfidReader replaced by ONE
  generated barcode label and the BarcodeScanner plugin (barcode_refactor_plan
  §3.2, §9.1 in inventory_tracking). Room, lights, plate, AprilTag and Spot are
  unchanged; the fiducial rig is shared between the two calibrations on purpose.

  LABEL POSE DERIVATION (world), for the latched-fiducial values in
  inventory_tracking/config/barcode_calibration_params.yaml:
    Plate at (2.0, 0, 0, yaw -1.5708): tag face plane lands at world x = 1.4845,
    fiducial origin (AprilTag centre) at world (1.4845, 0, 0.85).
    Latched frame: +X up the plate, +Y robot's left, +Z out of the plate.
    Label CENTRE (the plugin gates on the model origin) sits at
      world (1.4803, -0.14, 0.85)
    = fiducial [0.0, -0.14, 0.0042]: mid-height (the RFID target tag's spot,
    same reach argument), 0.14 m to the robot's right, substrate centre
    TAG_T/2 + 1 mm = 4.2 mm proud of the tag face plane.
    Substrate spans world x 1.4771..1.4835, entirely in front of the plate
    face at 1.485, so a beam from the robot reaches it without entering the
    occluder volume below.

  MOUNT BLOCK: all three lines (<link>, <pose>, <parent_frame>) must stay
  equal to inventory_tracking/urdf/barcode_scanner.xacro's measured
  exit-window pose (0.10473 0.0049 -0.1117 off arm0_hand, measured
  2026-07-31 — no longer the alpha-bore co-located value).
  The plugin's code defaults are link=arm0_hand with an IDENTITY mountPose, so
  omitting the override silently models the scanner ~12 cm and ~14 cm off the
  exit window (plan §5.3). This block is a CHECKED ITEM, not boilerplate.
-->
<sdf version="1.9">
  <world name="barcode_calibration">

    <plugin
        filename="ignition-gazebo-physics-system"
        name="ignition::gazebo::systems::Physics">
    </plugin>

    <plugin
        filename="ignition-gazebo-sensors-system"
        name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
        filename="ignition-gazebo-contact-system"
        name="ignition::gazebo::systems::Contact">
    </plugin>

    <plugin
        filename="ignition-gazebo-scene-broadcaster-system"
        name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="ignition-gazebo-user-commands-system"
        name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0.5</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
    </scene>

    <atmosphere type="adiabatic">
       <temperature>288</temperature>
       <temperature_gradient>0.2</temperature_gradient>
    </atmosphere>

    <!-- Two lights, same reasoning as rfid_calibration.sdf: the AprilTag is
         read by a camera and a single raking light blows out or shadows the
         quad. Doubly relevant here - the label texture is also camera-visible
         and a specular highlight across the bars is exactly what stops a real
         scanner decoding (the print visual is matte for the same reason). -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <light type="directional" name="plate_fill">
      <pose>0 0 2.0 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.7 0 -0.7</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===================== ROOM ENCLOSURE ===================== -->

    <model name="room_floor">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>15.0 15.0 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>15.0 15.0 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_front">
      <!-- -Y wall -->
      <static>true</static>
      <pose>0 -7.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>15.0 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>15.0 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_back">
      <!-- +Y wall -->
      <static>true</static>
      <pose>0 7.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>15.0 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>15.0 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_left">
      <!-- -X wall -->
      <static>true</static>
      <pose>-7.5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 15.0 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 15.0 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_wall_right">
      <!-- +X wall -->
      <static>true</static>
      <pose>7.5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 15.0 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 15.0 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== SPOT ===================== -->

    <model name="spot">
        <pose>-0.3 0.0 0.7 0 0 0</pose>
        <include merge="true">
            <uri>package://spot_description_sim/models/spot</uri>
        </include>

        <!-- Scanner block copied from server_room.sdf with the 16 rack
             occluders replaced by one for the calibration plate. See that
             file's comment block for the datasheet provenance of every value;
             none are changed here, because the label stock is the deployed one
             (plan §0.1) and the calibration must see the deployed physics. -->
        <plugin filename="BarcodeScanner" name="barcode::BarcodeScanner">
          <scanner_id>ls2208</scanner_id>
          <label_prefix>barcode_label_</label_prefix>
          <update_rate>100</update_rate>
          <mode>presentation</mode>
          <rescan_delay>0.05</rescan_delay>
          <topic>/barcode/scans</topic>
          <trigger_topic>/barcode/trigger</trigger_topic>
          <seed>42</seed>

          <publish_tf>true</publish_tf>
          <tf_topic>/barcode/tf</tf_topic>

          <dof_near>0.0381</dof_near>
          <dof_far>0.2540</dof_far>

          <symbol_width>0.0252</symbol_width>
          <symbol_height>0.003</symbol_height>
          <beam_spot>0.0002</beam_spot>

          <scan_halfangle>17.5</scan_halfangle>
          <auto_roll_limit>true</auto_roll_limit>
          <roll_limit>30</roll_limit>
          <pitch_limit>65</pitch_limit>
          <skew_limit>60</skew_limit>
          <specular_deadzone>0</specular_deadzone>

          <print_contrast>0.20</print_contrast>
          <label_contrast>0.85</label_contrast>

          <p_decode_max>0.99</p_decode_max>
          <margin_noise>0.05</margin_noise>

          <!-- Occluder volume matches the RFID world's: inset 2 cm behind the
               plate face so a beam to the proud-mounted label grazes rather
               than clips. 650 nm does not pass through the plate, so any
               intersection blocks outright - the volume is exact, not an
               attenuation placeholder. NOTE this is the beam occluder, NOT the
               arm collision box (model.sdf pulls that back for reachability);
               the two are independent - do not reconcile them. -->
          <occluder>
            <name>calibration_plate</name>
            <model>calibration_plate_model</model>
            <pose>0 0.015 0.9335 0 0 0</pose>
            <size>0.60 1.02 1.85</size>
          </occluder>

          <!-- Exit window: MEASURED 2026-07-31 against the seated clamshell
               CAD; equal to inventory_tracking/urdf/barcode_scanner.xacro
               (which see) and no longer the alpha-bore co-located value
               server_room.sdf still carries. The two files must stay equal
               (plan §5.3): the plugin's defaults silently model the scanner
               at the arm0_hand origin, and a wrong <link> warns once and
               then never decodes. -->
          <link>arm0_hand</link>
          <pose>0.10473 0.0049 -0.1117 0 0 0</pose>
          <parent_frame>arm0_hand</parent_frame>
        </plugin>
    </model>

    <!-- ===================== RACK + CALIBRATION PLATE =====================
         Identical placement to rfid_calibration.sdf: ~2 m in front of Spot
         along +X, yaw -1.5708 turns the model's -Y front face toward the
         robot; plate face lands at x = 1.485, tag plane at 1.4845. -->
    <include>
      <name>calibration_plate_model</name>
      <uri>model://calibration_plate_model</uri>
      <pose>2.0 0 0 0 0 -1.5708</pose>
    </include>

    <!-- ===================== PLATE BARCODE LABEL =====================
         ONE target label (plan §3.2): it carries the ladder, both angle arcs
         and the roll sweep. Mid-height at the RFID target tag's spot, for the
         same reach argument. Generated by generate_barcode_labels.py - -plate
         (never hand-edit the model), so its printed dimensions are exactly the
         deployed rack stock's, which is what <auto_roll_limit> reads.

         The include <name> IS the payload contract: BarcodeScanner matches the
         plain unscoped name against label_prefix and reports the suffix as the
         decode. It must equal target_payload in
         inventory_tracking/config/barcode_calibration_params.yaml.
         yaw -1.5708 sends the label's -Y outward normal toward the robot and
         its +X symbol axis horizontal (world -Y), bars vertical stripes
         reading left-to-right from the robot's viewpoint. -->
    <include>
      <name>barcode_label_CA11B07</name>
      <uri>model://barcode_plate_target</uri>
      <pose>1.4803 -0.14 0.85 0 0 -1.5708</pose>
    </include>

  </world>
</sdf>
