<?xml version="1.0"?>
<!--
  server_rack_6 — dense compute 42U rack.

  Same equipment as server_rack_2, but the tag column is MIRRORED to local
  x = -0.18 (the viewer's left from the aisle) and the EPC block is E200-6xxx.
  Target: Gazebo Ignition Fortress (ign-gazebo 6.x) / ROS 2 Humble.

  See server_rack_1/model.sdf for the shared conventions (frame geometry, tag
  placement, why nested models are used, and what the including world must do).
  Only the differences are documented here.

  ===== U-map (1 RU = 44.45 mm)
    U1-U4    ups                 4RU UPS
    U5       pdu_1               1RU PDU (A feed)
    U6-U7    switch_1            2RU ToR switch
    U8-U9    switch_2            2RU ToR switch (redundant)
    U10      cable_manager_1     1RU horizontal cable manager
    U11-U12  server_1            2RU server
    U13-U14  server_2
    U15-U16  server_3
    U17-U18  server_4
    U19-U20  server_5
    U21-U22  server_6
    U23-U24  server_7
    U25-U26  server_8
    U27-U28  server_9
    U29-U30  server_10
    U31-U32  server_11
    U33-U34  server_12
    U35      cable_manager_2     1RU
    U36-U37  server_13
    U38-U39  server_14
    U40      pdu_2               1RU PDU (B feed)
    U41      firewall            1RU
    U42      console_server      1RU
  42U occupied, 0U empty, 23 tags.

  The stress case for tag discrimination: U11-U34 is 12 identical 2RU servers
  with no break, so adjacent tag centers are 88.9 mm apart with nothing to
  distinguish them but z. A reader that resolves EPC but not shelf position
  will look correct on rack 1 and fall over here.
-->
<sdf version="1.9">
  <model name="server_rack_6">
    <static>true</static>

    <!-- ===================== FRAME ===================== -->

    <link name="frame_side_left">
      <pose>-0.29 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_side_right">
      <pose>0.29 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_top">
      <pose>0 0 2.01 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.60 1.07 0.02</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.60 1.07 0.02</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_plinth">
      <pose>0 0 0.025 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.60 1.07 0.05</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.60 1.07 0.05</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
    </link>

