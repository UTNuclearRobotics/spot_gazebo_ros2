<?xml version="1.0"?>
<model>
  <name>server_rack_2</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>spot_gazebo_ros2</name>
  </author>

  <description>
    42U server rack, dense compute configuration. Fully populated, no empty U.
    14 x 2RU servers behind a ToR switch pair, dual PDU, edge firewall and
    console server. 23 RFID tags (rfid_tag_r2_*), EPC block
    E200-2001..E200-2017.

    The high-tag-density case: 14 of the 23 tags are 2RU servers stacked back
    to back, so consecutive tag centers are only 88.9 mm apart. Use this rack
    to exercise tag-to-tag discrimination and the reader's ability to resolve
    which shelf a read came from.
  </description>
</model>
