<?xml version="1.0"?>
<model>
  <name>server_rack_3</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>spot_gazebo_ros2</name>
  </author>

  <description>
    42U server rack, storage configuration. 37U occupied, 5U empty
    (U23-U24 and U40-U42). Four 4RU disk shelves, a 6RU tape library, dual
    storage controllers and a SAN switch pair. 13 RFID tags (rfid_tag_r3_*),
    EPC block E200-3001..E200-300D.

    The occlusion case: chassis here are 0.75-0.80 m deep against 0.42-0.70 m
    elsewhere, so this rack is a far more solid block of metal than rack 1.
    If your &lt;occluder&gt; attenuation is tuned only against rack 1 it will be
    too weak here.
  </description>
</model>
