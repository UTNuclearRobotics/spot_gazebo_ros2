<?xml version="1.0"?>
<!--
  server_rack_7 — storage 42U rack.

  Same equipment as server_rack_3, but the tag column is MIRRORED to local
  x = -0.18 (the viewer's left from the aisle) and the EPC block is E200-7xxx.
  Target: Gazebo Ignition Fortress (ign-gazebo 6.x) / ROS 2 Humble.

  See server_rack_1/model.sdf for the shared conventions (frame geometry, tag
  placement, why nested models are used, and what the including world must do).
  Only the differences are documented here.

  ===== U-map (1 RU = 44.45 mm)
    U1-U4    ups                    4RU UPS
    U5       pdu                    1RU PDU
    U6-U7    san_switch_1           2RU fibre channel switch
    U8-U9    san_switch_2           2RU fibre channel switch (redundant)
    U10      cable_manager_1        1RU horizontal cable manager
    U11-U14  disk_shelf_1           4RU JBOD, 0.75 m deep
    U15-U18  disk_shelf_2
    U19-U22  disk_shelf_3
    U23-U24  - EMPTY (2U) -     decommissioned shelf, not yet refilled
    U25-U28  disk_shelf_4
    U29-U30  storage_controller_1   2RU
    U31-U32  storage_controller_2   2RU
    U33-U38  tape_library           6RU, 0.80 m deep
    U39      cable_manager_2        1RU
    U40-U42  - EMPTY (3U) -     reserved for a second tape drive
  37U occupied, 5U empty, 13 tags.

  ===== Why this rack matters for the RF model
  Chassis depth here is 0.75-0.80 m versus 0.42-0.70 m in rack 1, and the
  U11-U38 span is a near-continuous slab of it. The <occluder> box in the
  RfidReader config approximates the whole rack as one uniform volume with a
  single <attenuation_db_per_m>, which is already a coarse fit for rack 1 and is
  materially optimistic here. Test E should be run against this rack too, not
  just the baseline, or the estimator will be tuned on the easy geometry.

  The empty U's are the point of this configuration: they are genuinely empty
  (no link, no tag), so a reader that infers occupancy from read failures has
  to distinguish "nothing there" from "there but not read".
-->
<sdf version="1.9">
  <model name="server_rack_7">
    <static>true</static>

    <!-- ===================== FRAME ===================== -->

    <link name="frame_side_left">
      <pose>-0.29 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_side_right">
      <pose>0.29 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_top">
      <pose>0 0 2.01 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.60 1.07 0.02</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.60 1.07 0.02</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_plinth">
      <pose>0 0 0.025 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.60 1.07 0.05</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.60 1.07 0.05</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ===================== EQUIPMENT ===================== -->

    <!-- 4RU UPS, U1-U4 -->
    <link name="ups">
      <pose>0 -0.15 0.1389 0 0 0</pose>
