<?xml version="1.0"?>
<!--
  server_rack_5 — network / patch-heavy 42U rack.

  Same equipment as server_rack_1, but the tag column is MIRRORED to local
  x = -0.18 (the viewer's left from the aisle) and the EPC block is E200-5xxx.
  Racks 5-8 exist so one mission sees both tag columns, which is what Phase 5
  of doc/versatility_roadmap.md needs to learn the column instead of assuming
  it (discovery_params.yaml tag_column / tag_column_offset).
  Target: Gazebo Ignition Fortress (ign-gazebo 6.x) / ROS 2 Humble.

  Geometrically identical to the inline `server_rack` model formerly defined in
  worlds/server_rack_rfid.sdf. Use it as the regression baseline: including this
  model at pose "0 4.0 -0.1 0 0 0" reproduces that world exactly, EXCEPT that
  the tags are now nested models and therefore RIDE THE RACK POSE. In the old
  world they were independent world models pinned to absolute world y = 3.497,
  so moving the rack silently left them behind. That is fixed here.

  ===== U-map (1 RU = 44.45 mm; usable space starts at z = 0.05 in rack frame)
    U1-U4    ups                 4RU UPS
    U5       pdu                 1RU PDU
    U6-U7    switch_1            2RU network switch
    U8-U9    patch_panel_1       2RU copper patch panel
    U10      cable_manager_1     1RU horizontal cable manager
    U11-U12  switch_2
    U13-U14  patch_panel_2
    U15      cable_manager_2
    U16-U17  switch_3
    U18-U19  patch_panel_3
    U20      cable_manager_3
    U21-U22  switch_4
    U23-U24  patch_panel_4
    U25      cable_manager_4
    U26-U29  fiber_patch_panel   4RU fiber patch panel
    U30-U31  server_1            2RU server
    U32-U33  server_2
    U34-U35  server_3
    U36-U37  server_4
    U38-U39  server_5
    U40-U41  server_6
    U42      kvm                 1RU KVM console
  42U occupied, 0U empty, 22 tags.

  z_center(Ua..Ub) = 0.05 + ((a-1)+b)/2 * 0.04445
  height(Ua..Ub)   = (b-a+1) * 0.04445

  ===== Tags
  Nested models named rfid_tag_r5_<equipment>, on the front faceplate
  (front of rack = -Y, local y = -0.50; tags sit 3 mm proud at y = -0.503).
  VISUAL-ONLY (no <collision>) so lidar / depth sensors and costmaps are not
  affected by the 4 mm protrusions.

  RfidReader matches the PLAIN, UNSCOPED components::Name with no world-parent
  filter (RfidReader.cc:556-626), so nested tags are discovered exactly like
  top-level ones — but that also means the r1_ prefix is what keeps them unique
  across racks. <include><name> cannot rename them; the name here is final.

  ===== Two things the including world must do
  1. Do NOT rename on include. The reader's <occluder><model> resolves via
     EntityByComponents(Name(...), Model()) — plain name, no scoping. Rename the
     model and attenuation silently stops (one ignwarn, then optimistic reads).
     Add an occluder block naming "server_rack_5".
  2. The RFComms world plugin must be present for the CommsEndpoint tags below
     to do anything. RfidReader itself is fully independent of CommsEndpoint —
     it reports the model Name, never the EPC address.
-->
<sdf version="1.9">
  <model name="server_rack_5">
    <static>true</static>

    <!-- ===================== FRAME ===================== -->

    <link name="frame_side_left">
      <pose>-0.29 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_side_right">
      <pose>0.29 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
