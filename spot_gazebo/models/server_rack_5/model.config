<?xml version="1.0"?>
<model>
  <name>server_rack_5</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>spot_gazebo_ros2</name>
  </author>

  <description>
    42U server rack, network / patch-heavy configuration. Fully populated,
    no empty U. 22 RFID tags (rfid_tag_r5_*), EPC block E200-5001..E200-5016.

    Geometrically identical to the inline server_rack model that was defined
    in worlds/server_rack_rfid.sdf, so it is the regression baseline for the
    other three configurations.
  </description>
</model>
