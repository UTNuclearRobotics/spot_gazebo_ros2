    <!-- ===================== RFID TAGS ===================== -->

    <!-- ups, U1-4 -->
    <model name="barcode_label_031FB3A">
      <static>true</static>
      <pose>0.18 -0.5042 0.1389 0 0 0</pose>
      <link name="label_link">
        <visual name="substrate">
          <geometry><box><size>0.03810 0.00635 0.01270</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <!-- Printed face, 0.1 mm proud of the substrate so it never
             z-fights. Rotating +90 deg about X sends the quad's +Z
             face to -Y (the aisle) and its +Y to world up, so the
             texture reads the right way round. -90, which is what
             calibration_plate_model uses, points the BACK face out
             and flips the image. Code 128 is bi-directional so a
             mirrored symbol still decodes, but the human-readable
             line would be reversed. roughness 1 / metalness 0 keeps
             it matte: a specular highlight across the bars is
             exactly what stops a real scanner decoding. -->
        <visual name="print">
          <pose>0 -0.00327 0 1.5708 0 0</pose>
          <geometry><box><size>0.03810 0.01270 0.0002</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://barcode_labels/materials/textures/031FB3A.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

