<?xml version="1.0"?>
<!--
  server_rack_4 — partially populated / mid-commissioning 42U rack.
  Target: Gazebo Ignition Fortress (ign-gazebo 6.x) / ROS 2 Humble.

  See server_rack_1/model.sdf for the shared conventions (frame geometry, tag
  placement, why nested models are used, and what the including world must do).
  Only the differences are documented here.

  ===== U-map (1 RU = 44.45 mm)
    U1-U4    ups                 4RU UPS
    U5       pdu                 1RU PDU
    U6       - EMPTY (1U) -
    U7-U8    switch_1            2RU network switch
    U9       firewall            1RU
    U10      - EMPTY (1U) -
    U11-U12  patch_panel_1       2RU copper patch panel
    U13      cable_manager_1     1RU horizontal cable manager
    U14-U17  - EMPTY (4U) -
    U18-U27  blade_chassis       10RU blade enclosure, 0.78 m deep
    U28      - EMPTY (1U) -
    U29-U30  server_1            2RU server
    U31-U32  server_2
    U33-U38  - EMPTY (6U) -
    U39      console_server      1RU
    U40      - EMPTY (1U) -
    U41      - EMPTY (1U) -
    U42      kvm                 1RU KVM console
  27U occupied, 15U empty across six gaps, 11 tags.

  ===== Why this rack matters
  The inverse of rack 2. Tag spacing is large (the U28 gap alone puts 0.31 m
  between the blade chassis tag and server_1), so read-to-shelf attribution is
  easy. What is hard is the negative space: 15U of the rack is genuinely empty,
  with no link and no tag. An estimator that reads "no detection" as "present
  but occluded" will over-report inventory here, and no amount of occluder
  tuning fixes that — it needs an asset manifest to score against. See
  models/rack_tag_manifest.csv.

  Note also that <report_n_tags> in the RfidReader config leaks the true tag
  count. With 11 tags here against 23 in rack 2, an estimator quietly relying
  on that number will post a much better score on this rack than its actual
  inference deserves. Flip report_n_tags to false before drawing any
  cross-rack conclusions.
-->
<sdf version="1.9">
  <model name="server_rack_4">
    <static>true</static>

    <!-- ===================== FRAME ===================== -->

    <link name="frame_side_left">
      <pose>-0.29 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_side_right">
      <pose>0.29 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 1.07 2.0</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="frame_top">
      <pose>0 0 2.01 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.60 1.07 0.02</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.60 1.07 0.02</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
