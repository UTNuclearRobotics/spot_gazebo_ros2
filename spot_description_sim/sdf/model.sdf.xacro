<?xml version="1.0"?>
<!--
  model.sdf.xacro

  Xacro source for the Gazebo model. Generated into models/spot/model.sdf at
  build time (see CMakeLists.txt); the world files' existing
  <include><uri>package://spot_description_sim/models/spot</uri></include>
  keeps working unchanged.

  Frame offsets shared with the TF tree (urdf/spot.urdf.xacro) come from
  urdf/spot_frame_properties.xacro, so the numbers exist in exactly one place.
  Physics-only content (inertials, joint dynamics, PID gains, collision
  tuning) is intentionally sim-specific and lives here.

-->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <model name="spot">

    <xacro:include filename="../urdf/spot_frame_properties.xacro"/>

    <!-- Sensor toggles. Body cameras off by default (render/bridge load);
         hand cameras on (primary manipulation sensors, mirror
         spot_image_server on hardware). -->
    <xacro:arg name="enable_body_cameras" default="false"/>
    <xacro:arg name="enable_hand_cameras" default="true"/>
    <xacro:property name="enable_body_cameras" value="$(arg enable_body_cameras)"/>
    <xacro:property name="enable_hand_cameras" value="$(arg enable_hand_cameras)"/>

    <!-- ================= boilerplate macros ================= -->

    <xacro:macro name="tiny_inertial">
      <inertial>
        <mass>1e-05</mass>
        <inertia>
          <ixx>1e-09</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-09</iyy><iyz>0</iyz><izz>1e-09</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <!-- Fixed joint with the (inert) axis/physics boilerplate the previous
         hand-written SDF carried on most of its fixed joints. -->
    <xacro:macro name="sdf_fixed_joint" params="name parent child">
      <joint name="${name}" type="fixed">
        <child>${child}</child>
        <parent>${parent}</parent>
        <axis>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
        </axis>
        <physics>
          <ode>
            <limit>
              <cfm>0</cfm>
              <erp>0.2</erp>
            </limit>
          </ode>
        </physics>
      </joint>
    </xacro:macro>

    <xacro:macro name="foot_contact_surface">
      <surface>
        <contact>
          <ode>
            <kp>1e+07</kp>
            <kd>100</kd>
          </ode>
        </contact>
        <friction>
          <ode>
            <mu>0.8</mu>
            <mu2>0.8</mu2>
          </ode>
        </friction>
      </surface>
    </xacro:macro>

    <!-- ================= body ================= -->

    <link name="base_link">
      <inertial>
        <pose>0.005937 0.000326 0.04636 0 -0 0</pose>
        <mass>20.492</mass>
        <inertia>
          <ixx>0.287877</ixx>
          <ixy>0.0014834</ixy>
          <ixz>-0.0347842</ixz>
          <iyy>1.31868</iyy>
          <iyz>-0.000519074</iyz>
          <izz>1.18915</izz>
        </inertia>
      </inertial>
      <collision name="base_link_collision">
        <geometry>
          <mesh>
            <uri>package://spot_description_sim/models/spot/meshes/body_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>package://spot_description_sim/models/spot/meshes/body.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <self_collide>0</self_collide>
    </link>
    <link name="body">
      <xacro:tiny_inertial/>
    </link>
    <xacro:sdf_fixed_joint name="base_link_joint" parent="body" child="base_link"/>

    <link name="front_rail">
      <pose>${front_rail_xyz} 0 0 0</pose>
      <xacro:tiny_inertial/>
    </link>
    <xacro:sdf_fixed_joint name="front_rail_joint" parent="body" child="front_rail"/>

    <link name="rear_rail">
      <pose>${rear_rail_xyz} 0 0 0</pose>
      <xacro:tiny_inertial/>
    </link>
    <xacro:sdf_fixed_joint name="rear_rail_joint" parent="body" child="rear_rail"/>

    <!-- ================= RL kit payload chain ================= -->
    <!-- Absolute poses are derived in spot_frame_properties.xacro from the
         same per-joint offsets the hardware URDF uses:
         base_link -> payload_mount_reference_frame -> rl_kit_reference_frame
                   -> rl_kit_jetson_housing_box -> rl_kit_elevated_lidar_mount
                   -> velodyne_base_link -> velodyne                        -->

    <link name="payload_mount_reference_frame">
      <pose>${payload_x} 0 ${payload_z} 0 0 0</pose>
      <xacro:tiny_inertial/>
    </link>
    <joint name="payload_mount_reference_frame_joint" type="fixed">
      <parent>body</parent>
      <child>payload_mount_reference_frame</child>
    </joint>

    <link name="rl_kit_jetson_housing_box">
      <pose>${jetson_abs_x} 0 ${jetson_abs_z} 0 0 0</pose>
      <visual name="housing">
        <pose>0.02 0 -0.056 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://spot_proprietary_description/meshes/accessories/rl_kit_jetson_housing_box.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="jetson">
        <pose>0 0 -0.056 0 0 ${pi/2}</pose>
        <geometry>
          <mesh>
            <uri>package://spot_proprietary_description/meshes/accessories/jetson_orin_dev_kit.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.01 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.136 0.2 0.112</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rl_kit_jetson_housing_box_joint" type="fixed">
      <parent>payload_mount_reference_frame</parent>
      <child>rl_kit_jetson_housing_box</child>
    </joint>

    <link name="rl_kit_elevated_lidar_mount">
      <pose>${elev_abs_x} 0 ${elev_abs_z} 0 0 0</pose>
      <visual name="rl_kit_elevated_lidar_mount_visual">
        <geometry>
          <mesh>
            <uri>package://spot_proprietary_description/meshes/accessories/elevated_lidar_mount.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="rl_kit_elevated_lidar_mount_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.13 0.115 0.12</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rl_kit_velodyne_mount_joint" type="fixed">
      <parent>rl_kit_jetson_housing_box</parent>
      <child>rl_kit_elevated_lidar_mount</child>
    </joint>

    <link name="velodyne_base_link">
      <pose>${elev_abs_x} 0 ${vlp16_abs_z} 0 0 0</pose>
      <collision name="collision">
        <pose>0 0 0.03585 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0516</radius>
            <length>0.0717</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>package://spot_description_sim/models/spot/meshes/lidar_3d_v1.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.83</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>1e-06</ixy>
          <ixz>1e-06</ixz>
          <iyy>0.001</iyy>
          <iyz>1e-06</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rl_kit_velodyne_joint" type="fixed">
      <parent>rl_kit_elevated_lidar_mount</parent>
      <child>velodyne_base_link</child>
    </joint>

    <!-- VLP-16 beam-origin frame; offset matches velodyne_description -->
    <link name="velodyne">
      <pose relative_to="velodyne_base_link">0 0 ${vlp16_optical_z} 0 0 0</pose>
      <xacro:tiny_inertial/>
      <sensor name='gpu_lidar' type='gpu_lidar'>
        <pose>0 0 0 0 0 0</pose>
        <topic>model/spot/lidar</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>velodyne</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1800</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>100.0</max>
            <resolution>0.03</resolution>
          </range>
        </lidar>
        <alwaysOn>1</alwaysOn>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="velodyne_joint" type="fixed">
      <parent>velodyne_base_link</parent>
      <child>velodyne</child>
    </joint>

    <!-- ================= battery ================= -->

    <link name="battery">
      <pose>${battery_xyz} 0 -0 0</pose>
      <inertial>
        <mass>4</mass>
        <inertia>
          <ixx>0.012291</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.037875</iyy>
          <iyz>0</iyz>
          <izz>0.0444</izz>
        </inertia>
      </inertial>
      <collision name="battery_collision">
        <geometry>
          <box>
            <size>0.324 0.168 0.093</size>
          </box>
        </geometry>
      </collision>
      <visual name="battery_visual">
        <geometry>
          <box>
            <size>0.324 0.168 0.093</size>
          </box>
        </geometry>
        <material>
          <ambient>0.917647 0.654902 0 1</ambient>
          <diffuse>0.917647 0.654902 0 1</diffuse>
          <specular>0.917647 0.654902 0 1</specular>
          <emissive>0 0 0 0</emissive>
        </material>
      </visual>
    </link>
    <xacro:sdf_fixed_joint name="battery_joint" parent="base_link" child="battery"/>

    <!-- ================= body fisheye cameras ================= -->
    <!-- Poses single-sourced with urdf/include/sensor_frames_sim.urdf.xacro
         via spot_frame_properties.xacro. gz_frame_id makes the bridged image
         frame_ids resolve against the TF frames published from the URDF. -->

    <xacro:macro name="fisheye_camera" params="name xyz rpy">
      <link name="camera_${name}">
        <pose>${xyz} ${rpy}</pose>
        <xacro:tiny_inertial/>
        <sensor name="${name}_fisheye_image" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>model/spot/camera/${name}_fisheye_image</topic>
          <gz_frame_id>camera_${name}</gz_frame_id>
          <pose>0 0.01 0 0 -0 0</pose>
          <camera>
            <horizontal_fov>1.78634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>20</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.007</stddev>
            </noise>
            <lens>
              <intrinsics>
                <fx>257.487</fx>
                <fy>257.487</fy>
                <cx>319.5</cx>
                <cy>239.5</cy>
                <s>0</s>
              </intrinsics>
              <type>stereographic</type>
              <scale_to_hfov>1</scale_to_hfov>
            </lens>
          </camera>
        </sensor>
      </link>
      <xacro:sdf_fixed_joint name="camera_${name}_j" parent="base_link" child="camera_${name}"/>
    </xacro:macro>

    <!-- Body fisheye cameras: disabled by default to save render/bridge
         load; re-enable with enable_body_cameras:=true (CMake xacro args
         or a manual xacro invocation). Their URDF/TF frames remain either
         way, matching hardware where the driver always publishes them. -->
    <xacro:if value="${enable_body_cameras}">
      <xacro:fisheye_camera name="back"       xyz="${camera_back_xyz}"       rpy="${camera_back_rpy}"/>
      <xacro:fisheye_camera name="frontleft"  xyz="${camera_frontleft_xyz}"  rpy="${camera_frontleft_rpy}"/>
      <xacro:fisheye_camera name="frontright" xyz="${camera_frontright_xyz}" rpy="${camera_frontright_rpy}"/>
      <xacro:fisheye_camera name="left"       xyz="${camera_left_xyz}"       rpy="${camera_left_rpy}"/>
      <xacro:fisheye_camera name="right"      xyz="${camera_right_xyz}"      rpy="${camera_right_rpy}"/>
    </xacro:if>

    <!-- ============== hand cameras (gripper) ==============
         Mirrors the hardware spot_image_server sources:
           hand_rgb: gripper RGB camera. rgbd_camera so the depth_image
                     subtopic emulates hardware's depth-registered-in-RGB
                     (/spot_image_server/depth/hand_rgb).
           hand_tof: time-of-flight depth camera; its points subtopic feeds
                     /spot_pointclouds/hand_tof_points.
         Resolutions/FOV are NOMINAL — match them to the hardware
         camera_info (fx = width / (2*tan(hfov/2))) when metric accuracy
         matters. gz depth encoding is 32FC1 meters (hardware may publish
         16UC1 mm — check consumers). -->
    <xacro:macro name="hand_camera" params="name optical_frame x y z pitch width height hfov far points:=false">
      <link name="hand_${name}">
        <pose relative_to="arm0_wrist_roll_link">${x} ${y} ${z} 0 ${pitch} 0</pose>
        <inertial>
          <mass>1e-05</mass>
          <inertia>
            <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
            <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
          </inertia>
        </inertial>
        <sensor name="hand_${name}" type="rgbd_camera">
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <topic>model/spot/hand_${name}</topic>
          <gz_frame_id>${optical_frame}</gz_frame_id>
          <camera>
            <horizontal_fov>${hfov}</horizontal_fov>
            <image>
              <width>${width}</width>
              <height>${height}</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>${far}</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
        </sensor>
      </link>
      <xacro:sdf_fixed_joint name="hand_${name}_j" parent="arm0_wrist_roll_link" child="hand_${name}"/>
    </xacro:macro>

    <xacro:if value="${enable_hand_cameras}">
      <!-- optical_frame values are the Boston Dynamics driver TF names;
           they are optical-convention (z forward) frames published by RSP
           (see sensor_frames_sim.urdf.xacro). gz camera data follows the
           optical convention, so headers stamped with these frames project
           correctly. -->
      <xacro:hand_camera name="rgb" optical_frame="hand_color_image_sensor"
                         x="${hand_rgb_x}" y="${hand_rgb_y}" z="${hand_rgb_z}"
                         pitch="${hand_rgb_pitch}"
                         width="640" height="480" hfov="1.0472" far="15"/>
      <xacro:hand_camera name="tof" optical_frame="hand_depth_sensor"
                         x="${hand_tof_x}" y="${hand_tof_y}" z="${hand_tof_z}"
                         pitch="${hand_tof_pitch}"
                         width="224" height="171" hfov="0.9599" far="6"/>
    </xacro:if>

    <!-- ================= IMU ================= -->

    <link name="imu">
      <xacro:tiny_inertial/>
      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>model/spot/imu</topic>
        <gz_frame_id>imu</gz_frame_id>
        <imu>
          <enable_orientation>0</enable_orientation>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>2e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>2e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>2e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <xacro:sdf_fixed_joint name="imu_j" parent="base_link" child="imu"/>

    <!-- ================= legs ================= -->
    <!-- One macro, four reflections. Frame offsets come from
         spot_frame_properties.xacro (identical to the hardware URDF); masses,
         inertias, joint limits/efforts, and contact tuning are sim physics
         values carried over from the previous hand-written model.sdf. -->

    <xacro:macro name="spot_leg" params="prefix x_r y_r">
      <link name="${prefix}_hip">
        <pose>${x_r*hip_x} ${y_r*hip_y} 0 0 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.0027</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00416667</iyy>
            <iyz>0</iyz>
            <izz>0.00416667</izz>
          </inertia>
        </inertial>
        <collision name="${prefix}_hip_collision">
          <geometry>
            <mesh>
              <uri>package://spot_description_sim/models/spot/meshes/${prefix}_hip_collision.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="${prefix}_hip_visual">
          <geometry>
            <mesh>
              <uri>package://spot_description_sim/models/spot/meshes/${prefix}_hip.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <joint name="${prefix}_hip_x" type="revolute">
        <child>${prefix}_hip</child>
        <parent>body</parent>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-0.785398</lower>
            <upper>0.785398</upper>
            <effort>80</effort>
            <velocity>15.0</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>

      <link name="${prefix}_upper_leg">
        <pose>${x_r*hip_x} ${y_r*(hip_y + hip_to_upper_y)} 0 0 0 0</pose>
        <inertial>
          <pose>0 0 -0.14 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>0.0155334</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0155334</iyy>
            <iyz>0</iyz>
            <izz>0.000962667</izz>
          </inertia>
        </inertial>
        <collision name="${prefix}_upper_leg_collision">
          <geometry>
            <mesh>
              <uri>package://spot_description_sim/models/spot/meshes/${prefix}_upper_leg_collision.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="${prefix}_upper_leg_visual">
          <geometry>
            <mesh>
              <uri>package://spot_description_sim/models/spot/meshes/${prefix}_upper_leg.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <joint name="${prefix}_hip_y" type="revolute">
        <child>${prefix}_upper_leg</child>
        <parent>${prefix}_hip</parent>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-0.898845</lower>
            <upper>2.29511</upper>
            <effort>80</effort>
            <velocity>15.0</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>

      <link name="${prefix}_lower_leg">
        <pose>${x_r*hip_x + knee_x} ${y_r*(hip_y + hip_to_upper_y)} ${knee_z} 0 0 0</pose>
        <inertial>
          <pose>0 0 -0.16 0 -0 0</pose>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.00743438</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00740104</iyy>
            <iyz>0</iyz>
            <izz>0.000135417</izz>
          </inertia>
        </inertial>
        <collision name="${prefix}_lower_leg_collision">
          <geometry>
            <mesh>
              <scale>0.82 0.97 0.98</scale>
              <uri>package://spot_description_sim/models/spot/meshes/${prefix}_lower_leg_collision.stl</uri>
            </mesh>
          </geometry>
          <xacro:foot_contact_surface/>
        </collision>
        <collision name="${prefix}_lower_leg_collision_1">
          <pose>0 0 -0.333 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.036</radius>
            </sphere>
          </geometry>
          <xacro:foot_contact_surface/>
        </collision>
        <visual name="${prefix}_lower_leg_visual">
          <geometry>
            <mesh>
              <uri>package://spot_description_sim/models/spot/meshes/${prefix}_lower_leg.dae</uri>
            </mesh>
          </geometry>
          <material>
          </material>
        </visual>
        <sensor name="contact" type="contact">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <contact>
            <collision>${prefix}_lower_leg_collision</collision>
            <collision>${prefix}_lower_leg_collision_1</collision>
            <topic>contact/${prefix}</topic>
          </contact>
        </sensor>
      </link>
      <joint name="${prefix}_knee" type="revolute">
        <child>${prefix}_lower_leg</child>
        <parent>${prefix}_upper_leg</parent>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-2.7929</lower>
            <upper>-0.254801</upper>
            <effort>80</effort>
            <velocity>15.0</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>

      <link name="${prefix}_ee">
        <pose>${x_r*hip_x + knee_x} ${y_r*(hip_y + hip_to_upper_y)} ${knee_z + foot_offset_z} 0 0 0</pose>
        <inertial>
          <mass>1e-05</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>1e-06</ixy>
            <ixz>1e-06</ixz>
            <iyy>0.001</iyy>
            <iyz>1e-06</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
      <xacro:sdf_fixed_joint name="${prefix}_foot" parent="${prefix}_lower_leg" child="${prefix}_ee"/>
    </xacro:macro>

    <xacro:spot_leg prefix="front_left"  x_r="1"  y_r="1"/>
    <xacro:spot_leg prefix="front_right" x_r="1"  y_r="-1"/>
    <xacro:spot_leg prefix="rear_left"   x_r="-1" y_r="1"/>
    <xacro:spot_leg prefix="rear_right"  x_r="-1" y_r="-1"/>

    <!-- ============================================================ -->
    <!-- Spot Arm (arm0)                                              -->
    <!-- Frame layout matches spot_description/urdf/arm/               -->
    <!-- spot_arm.urdf.xacro with name="arm0".                        -->
    <!--                                                              -->
    <!-- SDF NAMING NOTE: SDF shares one namespace for links AND      -->
    <!-- joints. Links whose URDF names match a joint name are given  -->
    <!-- a _link suffix here to avoid collisions. Joint names are     -->
    <!-- unchanged so the JointTrajectoryController still works.      -->
    <!--                                                              -->
    <!-- Link poses are absolute in model frame at zero configuration -->
    <!-- and are derived in spot_frame_properties.xacro.              -->
    <!-- ============================================================ -->

    <link name="arm0_base_link">
      <pose>${arm_mount_x} 0 ${arm_mount_z} 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.001</iyy><iyz>0.0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.001 0.0002 -0.116 0 0.03 0</pose>
        <geometry>
          <mesh><uri>package://spot_proprietary_description/meshes/arm/arm0.base_link.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>-0.02 0 -0.08 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_mount" type="fixed">
      <parent>base_link</parent>
      <child>arm0_base_link</child>
    </joint>

    <link name="arm0_shoulder_yaw_link">
      <pose>${arm_mount_x} 0 ${arm_mount_z} 0 0 0</pose>
      <inertial>
        <mass>2.3364</mass>
        <inertia>
          <ixx>0.009014303</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.005835102</iyy><iyz>0.0</iyz><izz>0.007787478</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh><uri>package://spot_proprietary_description/meshes/arm/arm0.link_sh0.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.06</radius><length>0.18</length></cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_shoulder_yaw" type="revolute">
      <parent>arm0_base_link</parent>
      <child>arm0_shoulder_yaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <initial_position>-0.0011</initial_position>
        <limit>
          <lower>-2.61799387799149441136</lower>
          <upper>3.14159265358979311599</upper>
          <effort>90.9</effort><velocity>20.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- arm0_shoulder_pitch_link: no sh1 exists, reuse sh0 -->
    <link name="arm0_shoulder_pitch_link">
      <pose>${arm_mount_x} 0 ${arm_mount_z} 0 0 0</pose>
      <inertial>
        <mass>0.2596</mass>
        <inertia>
          <ixx>0.000203</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.000171</iyy><iyz>0.0</iyz><izz>0.000204</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh><uri>package://spot_proprietary_description/meshes/arm/arm0.link_sh0.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.06</radius><length>0.18</length></cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_shoulder_pitch" type="revolute">
      <parent>arm0_shoulder_yaw_link</parent>
      <child>arm0_shoulder_pitch_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14159265358979311599</lower>
          <upper>0.52359877559829881565</upper>
          <effort>181.8</effort><velocity>20.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- arm0_shoulder_roll_link: upper arm structural link (hr0 mesh) -->
    <link name="arm0_shoulder_roll_link">
      <pose>${arm_mount_x} 0 ${arm_mount_z} 0 0 0</pose>
      <inertial>
        <mass>1e-06</mass>
        <inertia>
          <ixx>6.3e-10</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>1.15e-08</iyy><iyz>0.0</iyz><izz>1.16e-08</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>package://spot_proprietary_description/meshes/arm/arm0.link_hr0.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.169 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.338</length></cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_shoulder_roll" type="fixed">
      <parent>arm0_shoulder_pitch_link</parent>
      <child>arm0_shoulder_roll_link</child>
    </joint>

    <link name="arm0_elbow_pitch_link">
      <pose>${arm_el0_abs_x} 0 ${arm_mount_z} 0 0 0</pose>
      <inertial>
        <mass>0.725</mass>
        <inertia>
          <ixx>0.000822</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.002005</iyy><iyz>0.0</iyz><izz>0.001972</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh><uri>package://spot_proprietary_description/meshes/arm/arm0.link_el0.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.25</length></cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_elbow_pitch" type="revolute">
      <parent>arm0_shoulder_roll_link</parent>
      <child>arm0_elbow_pitch_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <initial_position>3.1337</initial_position>
        <limit>
          <lower>0</lower>
          <upper>3.14159265358979311599</upper>
          <effort>90.9</effort><velocity>20.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="arm0_elbow_roll_link">
      <pose>${arm_el1_abs_x} 0 ${arm_el1_abs_z} 0 0 0</pose>
      <inertial>
        <mass>0.725</mass>
        <inertia>
          <ixx>0.000821</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.002004</iyy><iyz>0.0</iyz><izz>0.001972</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh><uri>package://spot_proprietary_description/meshes/arm/arm0.link_el1.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.04</radius><length>0.20</length></cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_elbow_roll" type="revolute">
      <parent>arm0_elbow_pitch_link</parent>
      <child>arm0_elbow_roll_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <initial_position>1.5699</initial_position>
        <limit>
          <lower>-2.79252680319092716487</lower>
          <upper>2.79252680319092716487</upper>
          <effort>90.9</effort><velocity>20.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="arm0_wrist_pitch_link">
      <pose>${arm_el1_abs_x} 0 ${arm_el1_abs_z} 0 0 0</pose>
      <inertial>
        <mass>0.98</mass>
        <inertia>
          <ixx>0.000985</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.000892</iyy><iyz>0.0</iyz><izz>0.001235</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh><uri>package://spot_proprietary_description/meshes/arm/arm0.link_wr0.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.04</radius><length>0.12</length></cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_wrist_pitch" type="revolute">
      <parent>arm0_elbow_roll_link</parent>
      <child>arm0_wrist_pitch_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <initial_position>-0.0027</initial_position>
        <limit>
          <lower>-1.83259571459404613236</lower>
          <upper>1.83259571459404613236</upper>
          <effort>30.3</effort><velocity>20.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="arm0_wrist_roll_link">
      <pose>${arm_el1_abs_x} 0 ${arm_el1_abs_z} 0 0 0</pose>
      <inertial>
        <mass>0.785</mass>
        <inertia>
          <ixx>0.000767</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.001763</iyy><iyz>0.0</iyz><izz>0.001682</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh><uri>package://spot_proprietary_description/meshes/arm/arm0.link_wr1.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.10</length></cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_wrist_roll" type="revolute">
      <parent>arm0_wrist_pitch_link</parent>
      <child>arm0_wrist_roll_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <initial_position>-1.5684</initial_position>
        <limit>
          <lower>-2.87979326579064354163</lower>
          <upper>2.87979326579064354163</upper>
          <effort>30.3</effort><velocity>20.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="arm0_fingers_link">
      <pose>${arm_fngr_abs_x} 0 ${arm_fngr_abs_z} 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000144</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.000301</iyy><iyz>0.0</iyz><izz>0.000391</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh><uri>package://spot_proprietary_description/meshes/arm/arm0.link_fngr.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <box><size>0.08 0.04 0.03</size></box>
        </geometry>
      </collision>
    </link>
    <joint name="arm0_fingers" type="revolute">
      <parent>arm0_wrist_roll_link</parent>
      <child>arm0_fingers_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <initial_position>-0.7223</initial_position>
        <limit>
          <lower>-1.57</lower>
          <upper>0.05</upper>
          <effort>15.32</effort><velocity>10.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Virtual / convenience frames (massless, no name conflicts) -->
    <link name="arm0_tool0">
      <pose>${arm_tool0_abs_x} 0 ${arm_el1_abs_z} 0 0 0</pose>
      <xacro:tiny_inertial/>
    </link>
    <joint name="arm0_ee_virtual_joint" type="fixed">
      <parent>arm0_wrist_roll_link</parent>
      <child>arm0_tool0</child>
    </joint>

    <link name="arm0_hand">
      <pose>${arm_tool0_abs_x} 0 ${arm_el1_abs_z} 0 0 0</pose>
      <xacro:tiny_inertial/>
    </link>
    <joint name="arm0_wrist_to_hand" type="fixed">
      <parent>arm0_wrist_roll_link</parent>
      <child>arm0_hand</child>
    </joint>

    <link name="arm0_mounting_frame">
      <pose>${arm_mountf_abs_x} 0 ${arm_mountf_abs_z} 0 0 0</pose>
      <xacro:tiny_inertial/>
    </link>
    <joint name="arm0_wrist_to_mounting_frame" type="fixed">
      <parent>arm0_wrist_roll_link</parent>
      <child>arm0_mounting_frame</child>
    </joint>

    <link name="arm0_link_wr1">
      <pose>${arm_el1_abs_x} 0 ${arm_el1_abs_z} 0 0 0</pose>
      <xacro:tiny_inertial/>
    </link>
    <joint name="arm0_link_wr1_to_wrist" type="fixed">
      <parent>arm0_wrist_roll_link</parent>
      <child>arm0_link_wr1</child>
    </joint>

    <!-- ================= plugins ================= -->

    <plugin
      filename="ignition-gazebo-imu-system"
      name="ignition::gazebo::systems::Imu">
    </plugin>

    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>model/spot/joint_state</topic>
      <update_rate>200</update_rate>
      <!-- Publish ONLY actuated joints, matching hardware
           /spot_driver/joint_states. Without this list the plugin publishes
           every joint including welded ones (feet, imu, battery, cameras,
           velodyne chain), which floods MoveIt's CurrentStateMonitor with
           "Joint not found in model" errors at the publish rate. -->
      <joint_name>front_left_hip_x</joint_name>
      <joint_name>front_left_hip_y</joint_name>
      <joint_name>front_left_knee</joint_name>
      <joint_name>front_right_hip_x</joint_name>
      <joint_name>front_right_hip_y</joint_name>
      <joint_name>front_right_knee</joint_name>
      <joint_name>rear_left_hip_x</joint_name>
      <joint_name>rear_left_hip_y</joint_name>
      <joint_name>rear_left_knee</joint_name>
      <joint_name>rear_right_hip_x</joint_name>
      <joint_name>rear_right_hip_y</joint_name>
      <joint_name>rear_right_knee</joint_name>
      <joint_name>arm0_shoulder_yaw</joint_name>
      <joint_name>arm0_shoulder_pitch</joint_name>
      <joint_name>arm0_elbow_pitch</joint_name>
      <joint_name>arm0_elbow_roll</joint_name>
      <joint_name>arm0_wrist_pitch</joint_name>
      <joint_name>arm0_wrist_roll</joint_name>
      <joint_name>arm0_fingers</joint_name>
    </plugin>

    <plugin
      filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <odom_publish_frequency>10</odom_publish_frequency>
      <odom_topic>/model/spot/odometry</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>body</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

    <xacro:macro name="pid_joint" params="joint p i d i_min:=-5.0 i_max:=5.0 init:=0.0">
      <joint_name>${joint}</joint_name>
      <initial_position>${init}</initial_position>
      <position_p_gain>${p}</position_p_gain>
      <position_i_gain>${i}</position_i_gain>
      <position_d_gain>${d}</position_d_gain>
      <position_i_min>${i_min}</position_i_min>
      <position_i_max>${i_max}</position_i_max>
    </xacro:macro>

    <plugin
      filename="ignition-gazebo-joint-trajectory-controller-system"
      name="ignition::gazebo::systems::JointTrajectoryController">
      <topic>model/spot/joint_trajectory</topic>

      <xacro:pid_joint joint="front_left_hip_x"  p="500" i="1" d="20"/>
      <xacro:pid_joint joint="front_left_hip_y"  p="500" i="1" d="20"/>
      <xacro:pid_joint joint="front_left_knee"   p="500" i="1" d="20"/>
      <xacro:pid_joint joint="front_right_hip_x" p="500" i="1" d="20"/>
      <xacro:pid_joint joint="front_right_hip_y" p="500" i="1" d="20"/>
      <xacro:pid_joint joint="front_right_knee"  p="500" i="1" d="20"/>
      <xacro:pid_joint joint="rear_left_hip_x"   p="500" i="1" d="20"/>
      <xacro:pid_joint joint="rear_left_hip_y"   p="500" i="1" d="20"/>
      <xacro:pid_joint joint="rear_left_knee"    p="500" i="1" d="20"/>
      <xacro:pid_joint joint="rear_right_hip_x"  p="500" i="1" d="20"/>
      <xacro:pid_joint joint="rear_right_hip_y"  p="500" i="1" d="20"/>
      <xacro:pid_joint joint="rear_right_knee"   p="500" i="1" d="20"/>

      <!-- Arm joints — arm0_shoulder_roll is fixed and excluded.
           init values = STOW_CONFIG from sim_manipulation_driver.py, so the
           controller's hold target matches the spawn pose set below. -->
      <xacro:pid_joint joint="arm0_shoulder_yaw"   p="500" i="0" d="20"  init="-0.0011"/>
      <xacro:pid_joint joint="arm0_shoulder_pitch" p="500" i="0" d="20"  init="-3.1360"/>
      <xacro:pid_joint joint="arm0_elbow_pitch"    p="500" i="0" d="20"  init="3.1337"/>
      <xacro:pid_joint joint="arm0_elbow_roll"     p="150" i="0" d="1"   init="1.5699"/>
      <xacro:pid_joint joint="arm0_wrist_pitch"    p="150" i="0" d="2"   init="-0.0027"/>
      <xacro:pid_joint joint="arm0_wrist_roll"     p="80"  i="0" d="0.2" init="-1.5684"/>
      <xacro:pid_joint joint="arm0_fingers"        p="30"  i="0" d="0.1" init="0.0"/>
    </plugin>

    <!-- Kinematically teleport the arm to stow on the first physics step.
         The JTC init targets above only make the PID *pull* toward stow
         (a violent pi-radian swing at spawn that kicks the body over); this
         plugin resets the joint states directly, so the arm is simply there.
         Values = STOW_CONFIG (sim_manipulation_driver.py). -->
    <plugin filename="JointStateInitializer"
            name="spot_gazebo::JointStateInitializer">
      <joint name="arm0_shoulder_yaw">-0.0011</joint>
      <joint name="arm0_shoulder_pitch">-3.1360</joint>
      <joint name="arm0_elbow_pitch">3.1337</joint>
      <joint name="arm0_elbow_roll">1.5699</joint>
