<?xml version="1.0"?>
<sdf version="1.8">
  <model name="spot">
    <link name="base_link">
      <inertial>
        <pose>0.005937 0.000326 0.04636 0 -0 0</pose>
        <mass>20.492</mass>
        <inertia>
          <ixx>0.287877</ixx>
          <ixy>0.0014834</ixy>
          <ixz>-0.0347842</ixz>
          <iyy>1.31868</iyy>
          <iyz>-0.000519074</iyz>
          <izz>1.18915</izz>
        </inertia>
      </inertial>
      <collision name="base_link_collision">
        <geometry>
          <mesh>
            <uri>package://spot_description_sim/models/spot/meshes/body_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>package://spot_description_sim/models/spot/meshes/body.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <self_collide>0</self_collide>
    </link>
    <link name="body">
      <inertial>
        <mass>1e-05</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>1e-06</ixy>
          <ixz>1e-06</ixz>
          <iyy>0.001</iyy>
          <iyz>1e-06</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="base_link_joint" type="fixed">
      <child>base_link</child>
      <parent>body</parent>
      <axis>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
        </ode>
      </physics>
    </joint>
    <link name="front_rail">
      <pose>0.223 0 0.0805 0 -0 0</pose>
      <inertial>
        <mass>1e-05</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>1e-06</ixy>
          <ixz>1e-06</ixz>
          <iyy>0.001</iyy>
          <iyz>1e-06</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ===================== RL KIT: PAYLOAD MOUNT CHAIN ===================== -->
    <!-- Absolute poses computed by summing offsets along the fixed-joint chain:
         base_link -> payload_mount_reference_frame (0.2075 0 0.0805)
                   -> rl_kit_reference_frame          (-0.292 0 0.056)
                   -> rl_kit_jetson_housing_box        (-0.078 0 0)
                   -> rl_kit_elevated_lidar_mount      (0.01 0 0.06)
                   -> velodyne_base_link               (0 0 0.12)
    -->

    <link name="rl_kit_jetson_housing_box">
      <pose>-0.1625 0 0.1365 0 0 0</pose>
      <visual name="housing">
        <pose>0.02 0 -0.056 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://spot_proprietary_description/meshes/accessories/rl_kit_jetson_housing_box.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="jetson">
        <pose>0 0 -0.056 0 0 1.5707963267948966</pose>
        <geometry>
          <mesh>
            <uri>package://spot_proprietary_description/meshes/accessories/jetson_orin_dev_kit.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.01 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.136 0.2 0.112</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="rl_kit_elevated_lidar_mount">
      <pose>-0.1525 0 0.1965 0 0 0</pose>
      <visual name="rl_kit_elevated_lidar_mount_visual">
        <geometry>
          <mesh>
            <uri>package://spot_proprietary_description/meshes/accessories/elevated_lidar_mount.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="rl_kit_elevated_lidar_mount_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.13 0.115 0.12</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
    </link>

    <!-- NOTE: pose below is the VLP-16 macro's *mount* frame. The real VLP-16
         xacro's actual laser-emission frame sits ~0.0377m higher internally.
         Verify against velodyne_description/urdf/VLP-16.urdf.xacro if exact
         alignment with real sensor output matters. -->
    <link name="velodyne_base_link">
      <pose>-0.1525 0 0.3165 0 0 0</pose>
      <collision name="collision">
        <pose>0 0 0.03585 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0516</radius>
            <length>0.0717</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>package://spot_description_sim/models/spot/meshes/lidar_3d_v1.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.83</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>1e-06</ixy>
          <ixz>1e-06</ixz>
          <iyy>0.001</iyy>
          <iyz>1e-06</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>
    <!-- VLP-16 beam-origin offset (+0.0377m above base_link, per Velodyne spec) -->
    <link name="velodyne">
      <pose relative_to="velodyne_base_link">0 0 0.0377 0 0 0</pose>
      <sensor name='gpu_lidar' type='gpu_lidar'>
        <pose>0 0 0 0 0 0</pose>
        <topic>model/spot/lidar</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>velodyne</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1800</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>100.0</max>
            <resolution>0.03</resolution>
          </range>
        </lidar>
        <alwaysOn>1</alwaysOn>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="velodyne_joint" type="fixed">
      <parent>velodyne_base_link</parent>
      <child>velodyne</child>
    </joint>
    <!-- ===================== END RL KIT CHAIN ===================== -->

    <link name="payload_mount_reference_frame">
      <pose>0.2075 0.0 0.0805 0 0 0</pose>
    </link>
    <joint name="payload_mount_reference_frame_joint" type="fixed">
