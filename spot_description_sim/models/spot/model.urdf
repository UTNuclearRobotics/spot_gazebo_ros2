<?xml version="1.0" ?>
<robot name="spot">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://spot_description_sim/models/spot/meshes/body.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://spot_description_sim/models/spot/meshes/body_collision.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="16.0"/>
      <inertia ixx="0.09733333333333333" ixy="0.0" ixz="0.0" iyy="1.0246666666666666" iyz="0.0" izz="1.0449333333333333"/>
    </inertial>
  </link>
  <link name="body"/>
  <joint name="base_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="body"/>
    <child link="base_link"/>
  </joint>
  <link name="front_rail"/>
  <joint name="front_rail_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.223 0 0.0805"/>
    <parent link="body"/>
    <child link="front_rail"/>
  </joint>
  <link name="rear_rail"/>
  <joint name="rear_rail_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.223 0 0.0805"/>
    <parent link="body"/>
    <child link="rear_rail"/>
  </joint>

  <!-- ===================== RL KIT: PAYLOAD MOUNT CHAIN ===================== -->
  <!-- Matches real-robot spot_urdf.xacro payload_mount_reference_frame -->
  <link name="payload_mount_reference_frame"/>
  <joint name="payload_mount_reference_frame_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.2075 0.0 0.0805"/>
    <parent link="body"/>
    <child link="payload_mount_reference_frame"/>
  </joint>

  <link name="rl_kit_reference_frame"/>
  <joint name="rl_kit_base_mount_to_body" type="fixed">
    <origin rpy="0 0 0" xyz="-0.292 0.0 0.056"/>
    <parent link="payload_mount_reference_frame"/>
    <child link="rl_kit_reference_frame"/>
  </joint>

  <link name="rl_kit_jetson_housing_box">
    <visual name="housing">
      <origin rpy="0 0 0" xyz="0.02 0 -0.056"/>
      <geometry>
        <mesh filename="package://spot_proprietary_description/meshes/accessories/rl_kit_jetson_housing_box.dae"/>
      </geometry>
    </visual>
    <visual name="jetson">
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 -0.056"/>
      <geometry>
        <mesh filename="package://spot_proprietary_description/meshes/accessories/jetson_orin_dev_kit.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.01 0.0 0.0"/>
      <geometry>
        <box size="0.136 0.2 0.112"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="rl_kit_jetson_housing_box_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.078 0.0 0.0"/>
    <parent link="rl_kit_reference_frame"/>
    <child link="rl_kit_jetson_housing_box"/>
  </joint>

  <link name="rl_kit_elevated_lidar_mount">
    <visual name="rl_kit_elevated_lidar_mount_visual">
      <geometry>
        <mesh filename="package://spot_proprietary_description/meshes/accessories/elevated_lidar_mount.stl"/>
      </geometry>
      <material name="gray">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision name="rl_kit_elevated_lidar_mount_collision">
      <origin rpy="0 0 0" xyz="0 0 0.06"/>
      <geometry>
        <box size="0.13 0.115 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>
  <joint name="rl_kit_velodyne_mount_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.01 0.0 0.06"/>
    <parent link="rl_kit_jetson_housing_box"/>
    <child link="rl_kit_elevated_lidar_mount"/>
  </joint>

  <!-- Velodyne VLP-16, mounted on top of the elevated lidar mount -->
  <!-- NOTE: this is the VLP-16 macro's *base* mount frame. The actual laser
       emission frame inside the real VLP-16 xacro sits ~0.0377m higher due
       to that macro's internal base_link -> velodyne frame offset. Verify
       against velodyne_description/urdf/VLP-16.urdf.xacro if exact alignment
       with real sensor data matters. -->
  <link name="velodyne_base_link">
    <visual>
      <geometry>
        <mesh filename="package://spot_description_sim/models/spot/meshes/lidar_3d_v1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.03585"/>
      <geometry>
        <cylinder radius="0.0516" length="0.0717"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.83"/>
      <inertia ixx="0.001" ixy="1e-06" ixz="1e-06" iyy="0.001" iyz="1e-06" izz="0.001"/>
    </inertial>
  </link>
  <joint name="rl_kit_velodyne_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.12"/>
    <parent link="rl_kit_elevated_lidar_mount"/>
    <child link="velodyne_base_link"/>
  </joint>

    <!-- VLP-16 actual laser-emission frame, offset above the mount per Velodyne spec -->
  <link name="velodyne"/>
  <joint name="velodyne_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.0377"/>
    <parent link="velodyne_base_link"/>
    <child link="velodyne"/>
  </joint>


  <!-- ===================== END RL KIT CHAIN ===================== -->

