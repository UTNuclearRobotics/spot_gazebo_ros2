        <initial_position>-0.7223</initial_position>
        <limit>
          <lower>-1.57</lower>
          <upper>0.05</upper>
          <effort>15.32</effort>
          <velocity>10.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>
